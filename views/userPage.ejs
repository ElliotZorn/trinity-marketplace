<!DOCTYPE html>
<html>
<head>
    <title>User Dashboard</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
</head>
<body>
    <%- include('header') %>

    <div class="user-home">
        <h1 >Welcome, <%= user.first_name %>!</h1>

        <div>
            <p>Update your details or delete your account.</p>
            <a href="/users/edit/<%= user.user_id %>"><button>Edit Profile</button></a>
            <a href="/users/delete/<%= user.user_id %>"><button>Delete Account</button></a>
        </div>

        <br>

        <div>
            <p>Manage your products:</p>
            <a href="/userProducts"><button>View My Products</button></a>
            <a href="/userProducts/interests"><button>Interests</button></a>
        </div>

        <br>

        <a href="/auth/logout"><button>Logout</button></a>

    </div>

</body>
</html>
