<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <title><%= name %> Products</title>

</head>

<body>
  <%- include('header') %>
  <div class="sidebar">
    <h2>Filter</h2>

    <form method="GET" action="">

      <label>Minimum Price</label>
      <input type="number" step="0.01" name="minPrice" value="<%= minPrice || '' %>">

      <label>Maximum Price</label>
      <input type="number" step="0.01" name="maxPrice" value="<%= maxPrice || '' %>">

    <label>Condition</label>
    <div class="checkbox-group">
      <label><input type="checkbox" name="condition" value="new" <%= condition?.includes('new') ? 'checked' : '' %>> New</label>
      <label><input type="checkbox" name="condition" value="used" <%= condition?.includes('used') ? 'checked' : '' %>> Used</label>
    </div>

    <label>Locations</label>
    <div class="checkbox-group">
      <% const allLocations = ['Myrtle','Isabella','City-Vista', 'Murchison']; %>
      <% allLocations.forEach(loc => { %>
        <label>
          <input type="checkbox" name="locations" value="<%= loc %>" <%= locations?.includes(loc) ? 'checked' : '' %>>
          <%= loc %>
        </label>
      <% }) %>
    </div>

    <label>Payment Methods</label>
    <div class="checkbox-group">
      <% const allPayments = ['cash','paypal','credit_card']; %>
      <% allPayments.forEach(pm => { %>
        <label>
          <input type="checkbox" name="paymentMethods" value="<%= pm %>" <%= paymentMethods?.includes(pm) ? 'checked' : '' %>>
          <%= pm.replace('_',' ') %>
        </label>
      <% }) %>
    </div>

      <button type="submit">Apply Filters</button>
    </form>
  </div>


  <div class="content">
    <h1><%= name %></h1>

    <% products.forEach(product => { %>
      <div class="item">
        <h2>
          <a href="/search/product/<%= product.product_id %>">
            <%= product.name %>
          </a>
        </h2>
        <h3>$<%= product.price.toFixed(2) %></h3>
      </div>
    <% }) %>

  </div>

</body>
</html>
