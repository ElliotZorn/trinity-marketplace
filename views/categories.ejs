<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <title>Category Search</title>
</head>
<body>
  <%- include('header') %>
  <h1>Category Search</h1>

<% Object.keys(categoryMap).forEach(parentName => { %>
  <% const children = categoryMap[parentName]; %>

  <% if (children.length === 1) { %>
    <% const child = children[0]; %>
    <form action="/search/categories/<%= child.slug %>" method="GET">
      <button type="submit" style="padding:10px 15px; margin-bottom:12px; border-radius:8px; border:1px solid #ccc; background:#f5f5f5; cursor:pointer; width:100%; text-align:left; font-size:18px; font-weight:bold;">
        <%= parentName %>
      </button>
    </form>
  <% } else { %>
    <details>
      <summary><%= parentName %></summary>
      <% children.forEach(child => { %>
        <div class="sub-item">
          <a href="/search/categories/<%= child.slug %>"><%= child.name %></a>
        </div>
      <% }) %>
    </details>
  <% } %>
<% }) %>

</body>
</html>
